    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  }
}
